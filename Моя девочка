<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>💖 Мини-игра</title>

<style>
body{
margin:0;
overflow:hidden;
font-family:Arial,sans-serif;
background:linear-gradient(180deg,#ffd6e8,#ffeef7);
}

.cat{
position:fixed;
font-size:35px;
animation:fly linear infinite;
pointer-events:none;
}

@keyframes fly{
0%{transform:translateX(-100px);}
100%{transform:translateX(calc(100vw + 100px));}
}

.box{
position:relative;
z-index:10;
max-width:420px;
margin:40px auto;
background:white;
padding:25px;
border-radius:20px;
box-shadow:0 0 20px rgba(0,0,0,.2);
text-align:center;
}

button{
margin:8px;
padding:12px 18px;
border:none;
border-radius:12px;
background:#ff5f96;
color:white;
font-size:17px;
cursor:pointer;
}

button:hover{
transform:scale(1.05);
}

#hearts{
font-size:30px;
margin:15px;
}

.hidden{
display:none;
}

h1{
color:#ff4f8b;
}
</style>
</head>

<body>

<div id="cats"></div>

<div class="box">

<h1>🐱 Добро пожаловать</h1>

<p>Миссия: набери 5 сердечек ❤️</p>

<div id="hearts">🤍🤍🤍🤍🤍</div>

<div id="game">

<h3>Вопрос 1</h3>
<p>Что поднимает настроение?</p>

<button onclick="next()">Музыка 🎵</button>
<button onclick="next()">Вкусняшки 🍫</button>
<button onclick="next()">Сообщение 😊</button>

</div>

<div id="end" class="hidden">
<h2>🎉 Ты прошла игру!</h2>

<p>
Если честно...
</p>

<h2 style="color:#ff4f8b">
Мне кажется, что самый лучший приз —
твоя улыбка. 😊❤️
</h2>

<button onclick="confetti()">
Нажми на сюрприз 🎁
</button>

<p id="final"></p>

</div>

</div>

<script>

const questions=[
["Какой цвет красивее?","💗 Розовый","💙 Голубой","💜 Фиолетовый"],
["Что лучше вечером?","🍕 Пицца","🍿 Фильм","🌅 Прогулка"],
["Что делает день счастливее?","😊 Улыбка","☕ Кофе","🎶 Музыка"],
["Кто сегодня заслуживает комплимент?","🙈 Я","😊 Ты","😺 Котик"]
];

let step=0;

function next(){

step++;

let hearts="";

for(let i=0;i<step;i++) hearts+="❤️";
for(let i=step;i<5;i++) hearts+="🤍";

document.getElementById("hearts").innerHTML=hearts;

if(step==5){
document.getElementById("game").style.display="none";
document.getElementById("end").classList.remove("hidden");
return;
}

let q=questions[step-1];

document.getElementById("game").innerHTML=`
<h3>Вопрос ${step+1}</h3>
<p>${q[0]}</p>

<button onclick="next()">${q[1]}</button>
<button onclick="next()">${q[2]}</button>
<button onclick="next()">${q[3]}</button>
`;

}

function confetti(){

document.getElementById("final").innerHTML=
